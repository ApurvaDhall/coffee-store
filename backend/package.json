{
  "name": "coffee-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "echo y | wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "echo y | wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:setup:remote": "npm run db:migrate:remote && npm run db:seed:remote"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.91.0"
  }
}